        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE posts SET\n  status = CASE WHEN status = 'publishing' THEN 'failed' ELSE 'draft_failed' END,\n  error = CASE WHEN status = 'publishing'\n    THEN 'Publishing did not finish. Check the Page before retrying, it may already be posted.'\n    ELSE 'Draft generation did not finish.' END\nWHERE status IN ('publishing', 'generating') AND updated_at < now() - interval '15 minutes';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "smPostgresCred01",
          "name": "SM App Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "fcb87bdd-9deb-5753-a48a-f8f3f4fed68f",
      "name": "Find Due Posts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS post_id FROM posts\nWHERE status = 'scheduled' AND publish_at <= now()\nORDER BY publish_at\nLIMIT 25;",
        "options": {}
