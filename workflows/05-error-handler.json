      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst lines = [\n  '🔥 n8n workflow error',\n  `Workflow: ${e.workflow?.name ?? 'unknown'}`,\n  e.execution?.lastNodeExecuted && `Node: ${e.execution.lastNodeExecuted}`,\n  `Error: ${e.execution?.error?.message ?? e.trigger?.error?.message ?? 'unknown'}`,\n  e.execution?.url && `Execution: ${e.execution.url}`,\n].filter(Boolean);\nreturn [{ json: { text: lines.join('\\n').slice(0, 4000) } }];\n"
      }
    },
    {
      "id": "ba7a8dc2-0a05-5af6-a508-4790b2f592ff",
