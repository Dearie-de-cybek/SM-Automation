# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# ---------- Dashboard ----------
# Public domain (DNS A record to this server); Caddy gets the TLS cert automatically.
DASHBOARD_DOMAIN=app.example.com
# Public URL of the dashboard, used for login links and OAuth redirects.
APP_URL=https://app.example.com
SESSION_SECRET=
# Optional: require this invite code on the public /signup page. Empty = open signup.
SIGNUP_CODE=

# ---------- Postgres ----------
POSTGRES_USER=n8n
# URL-safe characters only (openssl rand -hex 24): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
APP_DB_NAME=smapp
# Long-running services never use POSTGRES_USER. Keep all four logins distinct.
APP_DB_USER=sm_dashboard
APP_DB_PASSWORD=
OPERATOR_DB_USER=sm_operator_login
OPERATOR_DB_PASSWORD=
WORKER_DB_USER=sm_worker_login
WORKER_DB_PASSWORD=
N8N_DB_NAME=n8n
N8N_DB_USER=sm_n8n
N8N_DB_PASSWORD=

# ---------- Worker ----------
# Parallel job loops per queue.
WORKER_CONCURRENCY=4
# debug | info | warn | error
LOG_LEVEL=info

# ---------- Credentials encryption ----------
# Encrypts every stored provider credential (pgcrypto). BACK THIS UP: losing it makes
# every connected account unreadable and they all have to be reconnected.
TOKEN_ENCRYPTION_KEY=

# ---------- Telegram ----------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. AcmePostsBot (used for t.me links).
TELEGRAM_BOT_USERNAME=
# Random string sent as X-Telegram-Bot-Api-Secret-Token when you register the webhook.
TELEGRAM_WEBHOOK_SECRET=
# Your own chat ID: gets error alerts and admin access to the dashboard.
ADMIN_TELEGRAM_CHAT_ID=

# ---------- Gemini (AI) ----------
# From https://aistudio.google.com — use a billing-enabled project for client data.
GEMINI_API_KEY=
# Pinned model ids (aliases are hot-swapped by Google).
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_DEFAULT=gemini-3.8-flash
AI_MODEL_PREMIUM=gemini-3.1-pro-preview
AI_EMBEDDING_MODEL=gemini-embedding-2

# ---------- Media storage (Cloudflare R2 or any S3-compatible bucket) ----------
# Providers download media from a public URL, so the bucket needs public read access.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL that serves the bucket root (R2 custom domain or r2.dev), no trailing slash.
MEDIA_PUBLIC_BASE_URL=https://media.example.com

# ---------- Meta (Facebook Page + Instagram) ----------
# Optional: with an app configured, clients connect with "Continue with Facebook".
# Without it, the manual Page token form still works.
META_APP_ID=
META_APP_SECRET=
# Any random string; you type the same value into the Meta webhook setup form.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# ---------- Google (YouTube) ----------
# Optional: OAuth client (web application) with the YouTube Data API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Buffer (posting-only networks: X, LinkedIn, TikTok, Pinterest, …) ----------
# Optional: set the client id to offer "Connect with Buffer" (OAuth + PKCE).
# Without it, clients paste their own Buffer API key instead.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# ---------- Legacy n8n (compose profile "legacy-n8n", off by default) ----------
# Only one of (worker, n8n) may own the Telegram webhook.
N8N_DOMAIN=n8n.example.com
N8N_VERSION=latest
# BACK THIS UP. Losing it makes every stored n8n credential unreadable.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC
GEMINI_MODEL=gemini-2.5-flash
