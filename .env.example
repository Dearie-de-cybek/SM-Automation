# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# ---------- n8n ----------
# Public domain pointing at this server (DNS A record). Caddy gets the TLS cert automatically.
N8N_DOMAIN=n8n.example.com
# Pin to an exact version (e.g. 2.x.y) once everything works.
N8N_VERSION=latest
# BACK THIS UP. Losing it makes every stored n8n credential unreadable.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC

# ---------- Dashboard ----------
# Second domain (DNS A record to the same server) for the client dashboard.
DASHBOARD_DOMAIN=app.example.com
SESSION_SECRET=
# Optional: require this invite code on the public /signup page. Leave empty for open signup.
SIGNUP_CODE=

# ---------- Postgres ----------
POSTGRES_USER=n8n
# URL-safe characters only (openssl rand -hex 24): it is embedded in the dashboard DATABASE_URL.
POSTGRES_PASSWORD=
APP_DB_NAME=smapp

# ---------- Telegram ----------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. AcmePostsBot (used for t.me links).
TELEGRAM_BOT_USERNAME=
# Your own chat ID: gets error alerts and admin access to the dashboard (message the bot once; it shows the ID).
ADMIN_TELEGRAM_CHAT_ID=

# ---------- Gemini ----------
# From https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Meta ----------
META_GRAPH_VERSION=v24.0
# Encrypts client Page access tokens stored in the database. BACK THIS UP too.
TOKEN_ENCRYPTION_KEY=

# ---------- Media storage (Cloudflare R2 or any S3-compatible bucket) ----------
# Instagram downloads images from a public URL, so the bucket needs public read access.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL that serves the bucket root (R2 custom domain or r2.dev URL), no trailing slash.
MEDIA_PUBLIC_BASE_URL=https://media.example.com
